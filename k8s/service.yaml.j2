# One stable address in front of the pods: it load-balances requests across all ready pods.
# Type NodePort also opens a fixed port on the Minikube node, so you can reach the app from your machine.
apiVersion: v1
kind: Service
metadata:
  name: {{ app_name }}
  namespace: {{ k8s_namespace }}
spec:
  type: NodePort
  selector:
    app: {{ app_name }}
  ports:
    - port: 80             # port of the Service inside the cluster: http://{{ app_name }}
      targetPort: 8000     # port gunicorn listens on in the container
      nodePort: {{ k8s_node_port }}
